generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADOPTER
  PROTECTOR
  NGO
  ADMIN
}

enum AnimalStatus {
  AVAILABLE
  IN_PROCESS
  ADOPTED
  UNAVAILABLE
}

enum AnimalSpecies {
  DOG
  CAT
  OTHER
}

enum AnimalSex {
  MALE
  FEMALE
  UNKNOWN
}

enum RequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum VisitStatus {
  REQUESTED
  SCHEDULED
  CONFIRMED
  CHANGE_REQUESTED
  COMPLETED
  CANCELLED
}

model User {
  id                        String            @id @default(cuid())
  name                      String
  email                     String            @unique
  passwordHash              String?
  image                     String?
  emailVerified             DateTime?
  requiresEmailVerification Boolean           @default(false)
  failedLoginAttempts       Int               @default(0)
  lockedUntil               DateTime?
  suspendedAt               DateTime?
  role                      UserRole          @default(ADOPTER)
  phone                     String?
  city                      String?
  state                     String?
  organization              Organization?
  animals                   Animal[]
  adoptionRequests          AdoptionRequest[]
  requestHistory            RequestHistory[]
  sentMessages              Message[]
  notifications             Notification[]
  accounts                  Account[]
  sessions                  Session[]
  reportsMade               Report[]          @relation("ReportAuthor")
  reportsReceived           Report[]          @relation("ReportedUser")
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  verified    Boolean  @default(false)
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Animal {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  description  String
  species      AnimalSpecies
  breed        String?
  sex          AnimalSex
  ageMonths    Int?
  size         String?
  status       AnimalStatus      @default(AVAILABLE)
  city         String
  state        String
  latitude     Decimal?          @db.Decimal(9, 6)
  longitude    Decimal?          @db.Decimal(9, 6)
  imageUrls    String[]
  vaccinated   Boolean?
  neutered     Boolean?
  dewormed     Boolean?
  specialNeeds String?
  hiddenAt     DateTime?
  guardianId   String
  guardian     User              @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  requests     AdoptionRequest[]
  reports      Report[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([species, status, city, state])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  purpose    String   @default("EMAIL_VERIFY")

  @@unique([identifier, token])
}

model Report {
  id             String   @id @default(cuid())
  reason         String
  details        String?
  status         String   @default("OPEN")
  animalId       String?
  authorId       String
  reportedUserId String
  animal         Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  author         User     @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reportedUser   User     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([status, createdAt])
}

model AdoptionRequest {
  id           String           @id @default(cuid())
  message      String
  status       RequestStatus    @default(PENDING)
  decisionNote String?
  animalId     String
  adopterId    String
  animal       Animal           @relation(fields: [animalId], references: [id], onDelete: Cascade)
  adopter      User             @relation(fields: [adopterId], references: [id], onDelete: Cascade)
  visit        Visit?
  history      RequestHistory[]
  messages     Message[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([animalId, adopterId])
}

model Message {
  id                String          @id @default(cuid())
  content           String
  adoptionRequestId String
  senderId          String
  adoptionRequest   AdoptionRequest @relation(fields: [adoptionRequestId], references: [id], onDelete: Cascade)
  sender            User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@index([adoptionRequestId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  body      String
  href      String
  readAt    DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model RequestHistory {
  id                String          @id @default(cuid())
  action            String
  message           String?
  adoptionRequestId String
  actorId           String
  adoptionRequest   AdoptionRequest @relation(fields: [adoptionRequestId], references: [id], onDelete: Cascade)
  actor             User            @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@index([adoptionRequestId, createdAt])
}

model Visit {
  id                String          @id @default(cuid())
  scheduledAt       DateTime?
  location          String?
  notes             String?
  status            VisitStatus     @default(REQUESTED)
  adoptionRequestId String          @unique
  adoptionRequest   AdoptionRequest @relation(fields: [adoptionRequestId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}
